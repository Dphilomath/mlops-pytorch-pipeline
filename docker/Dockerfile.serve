# docker/Dockerfile.serve – multi‑stage build for a lightweight serving image
FROM python:3.11-slim AS builder
WORKDIR /app
COPY requirements/serve.txt requirements.txt
# Install CPU-only runtime dependencies to avoid downloading ~7.5GB of CUDA binaries
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt && rm -rf /root/.cache/pip

FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1
ENV TORCH_HOME=/tmp
WORKDIR /app
# Copy only the installed packages from the builder stage
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
# Create non‑root user for secure execution
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
USER appuser

# Copy source code and configuration (large data/checkpoints are ignored via .dockerignore)
COPY src/ ./src/
COPY configs/ ./configs/
# Expose port 8080
EXPOSE 8080

# Entry point for the FastAPI server
ENTRYPOINT ["uvicorn", "src.serve:app", "--host", "0.0.0.0", "--port", "8080"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 CMD curl -f http://localhost:8080/health || exit 1
