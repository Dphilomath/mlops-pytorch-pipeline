# Dockerfile.train – multi‑stage build for a lightweight training image
FROM python:3.11-slim AS builder
WORKDIR /app
COPY requirements/train.txt requirements.txt
# Install CPU-only runtime dependencies to avoid downloading ~7.5GB of CUDA binaries
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt && rm -rf /root/.cache/pip

FROM python:3.11-slim
WORKDIR /app
# Copy only the installed packages from the builder stage
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
# Copy source code and configuration (exclude large data/checkpoints via .dockerignore)
COPY src/ ./src/
COPY configs/ ./configs/
# Entry point for training
ENTRYPOINT ["python", "-m", "src.train"]
